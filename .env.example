# Signal channel configuration. Copy to ~/.claude/channels/signal/.env
# (the channels dir is created on first bridge boot if it doesn't exist).
#
# All keys are optional. Settings take effect on the next session restart —
# the bridge reads .env once at boot. Manage these via /signal:configure
# in your Claude Code session, or edit this file directly.

# Which signal-cli account the bridge uses. Auto-detected if exactly one
# account is linked. Set explicitly when 2+ accounts are linked.
# SIGNAL_ACCOUNT=+15551234567

# Owner for permission relay — the chat_id Claude DMs when it needs
# tool-use authorization. Defaults to SIGNAL_ACCOUNT.
# SIGNAL_OWNER=+15551234567

# Path overrides if signal-cli isn't on $PATH or its data dir is non-default.
# SIGNAL_CLI_PATH=/usr/local/bin/signal-cli
# SIGNAL_CLI_CONFIG=/var/lib/signal-cli

# Profile display name shown to recipients. Empty by default (no auto-set).
# Bridge only re-applies if the value differs from what was last set
# (tracked via the .profile-set marker file).
# SIGNAL_PROFILE_NAME=

# Auto-acknowledge inbound messages with a read receipt as they land,
# without waiting for Claude to reply. Default off (privacy posture: Claude
# controls what gets acknowledged via the mark_read tool).
# SIGNAL_AUTO_READ_RECEIPTS=false

# Append a "via Claude" footer to outbound replies so recipients know
# they're talking to an LLM bridge. Default off.
# SIGNAL_APPEND_SIGNATURE=false

# Set to "static" to freeze access.json into read-only mode — the bridge
# won't accept new pairings or write to access.json. Useful for reproducible
# deploys where access state should be baked into the deploy artifact.
# SIGNAL_ACCESS_MODE=static
