# claude-signal.service — systemd user unit
#
# Long-running Claude Code session with the signal-channel plugin auto-loaded.
# Runs as a *user* service (not root). Survives reboots once linger is enabled.
#
# Install:
#   1. Enable linger so the service runs without an active login session:
#        loginctl enable-linger "$USER"
#   2. Symlink (or copy) this file into your user units dir:
#        mkdir -p ~/.config/systemd/user
#        ln -s "$PWD/claude-signal.service" ~/.config/systemd/user/claude-signal.service
#   3. Reload and enable:
#        systemctl --user daemon-reload
#        systemctl --user enable --now claude-signal
#   4. Tail logs:
#        journalctl --user -u claude-signal -f
#
# Assumes the local marketplace lives at ~/repos/local-marketplace and that
# `claude` and `bun` are on PATH via the user's login shell (e.g. ~/.local/bin).

[Unit]
Description=Claude Code session with signal-channel plugin
Documentation=https://github.com/anthropics/claude-code
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/local-marketplace
ExecStart=/bin/sh -lc 'claude --dangerously-load-development-channels plugin:signal@local'
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
